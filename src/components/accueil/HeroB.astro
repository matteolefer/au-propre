---
/** Variante B (retenue, avec le titre de la variante A) : hero centré, fenêtre du rapport dans un panneau papier, coupée en bas. */
import ActionHero from './ActionHero.astro';
import { ApercuRapport } from '../verificateur/ApercuRapport';
---

<section class="accueil-section accueil-hero accueil-hero--b" aria-labelledby="titre-accueil">
  <h1 class="accueil-hero__titre" id="titre-accueil">Vérifiez votre dossier&nbsp;RAEP avant de le&nbsp;déposer</h1>
  <p class="accueil-hero__accroche">
    Pages, police, marges, interligne&nbsp;: déposez votre PDF et voyez ce qu’il faut corriger, et où.
  </p>
  <ActionHero />
  <div class="accueil-hero__apercu accueil-panneau">
    <ApercuRapport />
  </div>
</section>
