---
/** Hero centré, puis l'exemple de rapport dans un panneau bleu pâle, coupé en bas. */
import ActionHero from './ActionHero.astro';
import { ApercuRapport } from '../verificateur/ApercuRapport';
---

<section class="accueil-section accueil-hero" aria-labelledby="titre-accueil">
  <h1 class="accueil-hero__titre" id="titre-accueil">Vérifiez votre dossier&nbsp;RAEP en une&nbsp;minute</h1>
  <p class="accueil-hero__accroche">
    Dès le brouillon, voyez s’il respecte les règles de forme du jury et ce qu’il faut corriger.
  </p>
  <ActionHero />
  <div class="accueil-hero__apercu accueil-panneau">
    <ApercuRapport />
  </div>
</section>
